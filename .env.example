# MAINTENIS - Environment Configuration
# Copy this file to .env.local to connect to live Google Apps Script backend

# 1. Google Apps Script Web App Deployment URL (Leave empty for Offline Mock Mode)
# Example: https://script.google.com/macros/s/AKfycbx.../exec
VITE_GAS_API_URL=

# 2. Google OAuth 2.0 Web Client ID (Leave empty for Demo Role Switcher Mode)
# Obtained from Google Cloud Console -> APIs & Services -> Credentials
# Example: 123456789012-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=
